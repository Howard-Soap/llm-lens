# LLM Lens 环境变量配置

# ==================== 代理层 ====================

# 代理端口
LLM_LENS_PROXY_PORT=3000

# 数据库路径
LLM_LENS_DB_PATH=/data/llm-lens.db

# 日志级别 (debug, info, warn, error)
LLM_LENS_LOG_LEVEL=info

# ==================== API 层 ====================

# API 端口
LLM_LENS_API_PORT=8000

# ==================== 前端 ====================

# API 地址（前端访问）
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==================== 安全 ====================

# 本地模式（跳过认证）
LLM_LENS_LOCAL_MODE=true

# Session 密钥
LLM_LENS_SECRET_KEY=your-secret-key-change-this

# CORS 允许的域名
LLM_LENS_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==================== 数据隐私 ====================

# 隐私级别 (none, metadata, masked, full)
LLM_LENS_PRIVACY_LEVEL=metadata

# 数据保留天数
LLM_LENS_DATA_RETENTION_DAYS=30

# 是否记录 API Key（建议 false）
LLM_LENS_MASK_API_KEYS=true

# ==================== 高级配置 ====================

# 代理超时（秒）
LLM_LENS_PROXY_TIMEOUT=60

# 最大请求体大小（字节）
LLM_LENS_MAX_REQUEST_BODY_SIZE=10485760

# Rate Limit（每分钟请求数）
LLM_LENS_RATE_LIMIT=100
